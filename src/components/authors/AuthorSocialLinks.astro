---
import type { CollectionEntry } from 'astro:content';

interface Props { author: CollectionEntry<'authors'> }
const { author } = Astro.props;
const labels = {
  website: 'Website', github: 'GitHub', x: 'X / Twitter', bluesky: 'Bluesky', mastodon: 'Mastodon',
  twitch: 'Twitch', youtube: 'YouTube', linkedin: 'LinkedIn',
} as const;
const links = [
  ['website', author.data.website],
  ...Object.entries(author.data.socials),
].filter((entry): entry is [keyof typeof labels, string] => Boolean(entry[1]));
---

{links.length > 0 && (
  <ul class="author-socials" aria-label={`${author.data.name} profiles`}>
    {links.map(([platform, url]) => (
      <li>
        <a href={url} target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8 12h8M12 8v8" /></svg>
          <span>{labels[platform]}</span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .author-socials { display: flex; flex-wrap: wrap; gap: .75rem 1rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .author-socials a { display: inline-flex; gap: .4rem; align-items: center; }
  svg { width: 1.15rem; fill: none; stroke: currentColor; stroke-width: 1.8; }
</style>

