---
import BrandMark from './BrandMark.astro';
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div>
      <BrandMark compact />
      <p>Useful things worth keeping.</p>
    </div>
    <div class="site-footer__links">
      <a href="/stash/">Browse the stash</a>
      <a href="/projects/">Projects</a>
      <a href="/authors/">Authors</a>
      <a href="/contact/">Contact</a>
      <a href="/rss.xml">Website RSS</a>
      <a href="/podcast.xml">Podcast RSS</a>
      <a href="/videocast.xml">Videocast RSS</a>
    </div>
    <p class="site-footer__note">© {new Date().getFullYear()} Useful Stash</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 3rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem 3rem;
    align-items: start;
  }

  .site-footer p {
    margin: 0.65rem 0 0;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
  }

  .site-footer__note {
    grid-column: 1 / -1;
    font: 0.75rem var(--font-mono);
  }

  @media (max-width: 36rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }

    .site-footer__note {
      grid-column: auto;
    }
  }
</style>
