---
interface Props {
  text?: string;
}

const { text } = Astro.props;
---

<aside class="takeaway" aria-label="Takeaway">
  <p class="takeaway__label">[ TAKEAWAY ]</p>
  <div class="takeaway__body">
    {text ? <p>{text}</p> : <slot />}
  </div>
</aside>

<style>
  .takeaway {
    margin-block: clamp(2.2rem, 6vw, 4rem);
    padding: clamp(1.25rem, 4vw, 2rem);
    border-left: 5px solid var(--color-accent);
    background: var(--color-surface);
  }

  .takeaway__label {
    margin: 0 0 0.75rem;
    color: var(--color-tag);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }

  .takeaway__body :global(p) {
    max-width: 54ch;
    margin: 0;
    font-size: clamp(1.12rem, 2.2vw, 1.35rem);
    font-weight: 680;
    line-height: 1.45;
  }
</style>
