---
interface Props {
  name: string;
  label: string;
  required?: boolean;
}

const { name, label, required = false } = Astro.props;
const id = `field-${name}`;
---

<div class="checkbox-field">
  <label>
    <input id={id} type="checkbox" name={name} value="yes" required={required} />
    <span>{label}{required && <span class="checkbox-field__required" aria-hidden="true"> *</span>}</span>
  </label>
  <p class="form-field__error" data-error-for={name} role="alert"></p>
</div>

<style>
  .checkbox-field label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .checkbox-field input {
    margin-top: 0.2rem;
  }

  .checkbox-field__required {
    color: var(--color-accent);
  }

  .form-field__error {
    margin: 0.4rem 0 0;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .form-field__error:empty {
    display: none;
  }
</style>
