---
import type { CollectionEntry } from 'astro:content';
import AuthorByline from '../components/authors/AuthorByline.astro';
import ContentTag from '../components/ContentTag.astro';
import PostMediaPanel from '../components/media/PostMediaPanel.astro';
import Takeaway from '../components/Takeaway.astro';
import { buildBlogPosting, buildBreadcrumbs } from '../utils/structured-data';
import BaseLayout from './BaseLayout.astro';

interface Props { article: CollectionEntry<'articles'>; authors: CollectionEntry<'authors'>[] }
const { article, authors } = Astro.props;
const { title, description, slug, publishedAt, updatedAt, tags, takeaway, fixture, heroImage, heroImageAlt, seo, episode, podcast } = article.data;
const canonical = seo.canonical ?? new URL(`/stash/${slug}/`, Astro.site).href;
const dateFormat = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const jsonLd = [
  buildBlogPosting({ title, description, slug, publishedAt, updatedAt, heroImage, authors: authors.map(({ data }) => data), canonical }),
  buildBreadcrumbs([{ name: 'Home', path: '/' }, { name: 'Stash', path: '/stash/' }, { name: title, path: `/stash/${slug}/` }]),
];
---

<BaseLayout title={title} description={description} image={heroImage} type="article" noindex={fixture || seo.noindex} canonical={canonical} publishedAt={publishedAt} updatedAt={updatedAt} jsonLd={jsonLd}>
  <article>
    <header class="article-header container">
      <div class="article-header__tags">{tags.map((tag) => <ContentTag value={tag} />)}</div>
      {fixture && <p class="article-header__fixture">Sample article · local development only</p>}
      <h1>{title}</h1>
      <p class="article-header__description">{description}</p>
      <AuthorByline authors={authors} />
      {episode && podcast && <p class="article-header__episode">Season {podcast.season}, episode {episode}</p>}
      <div class="article-header__dates">
        <span>Published <time datetime={publishedAt.toISOString()}>{dateFormat.format(publishedAt)}</time></span>
        {updatedAt && <span>Updated <time datetime={updatedAt.toISOString()}>{dateFormat.format(updatedAt)}</time></span>}
      </div>
    </header>
    {heroImage && <div class="article-hero container"><img src={heroImage} alt={heroImageAlt ?? ''} /></div>}
    <div class="reading-shell article-body">
      <PostMediaPanel article={article} />
      <div class="prose"><slot /></div>
      {takeaway && <Takeaway text={takeaway} />}
      <nav class="article-next" aria-label="Continue browsing"><p class="meta-label">Keep looking</p><a href="/stash/">Browse the stash</a></nav>
    </div>
  </article>
</BaseLayout>

<style>
  .article-header { padding-block: clamp(4rem, 10vw, 8rem); }
  .article-header__tags { display: flex; flex-wrap: wrap; gap: .65rem 1rem; }
  .article-header__fixture { margin: 1.2rem 0 0; color: var(--color-muted); font: .75rem var(--font-mono); }
  h1 { max-width: 18ch; margin: 1.7rem 0 0; font-size: clamp(3rem, 9vw, 7rem); letter-spacing: -.065em; line-height: .92; }
  .article-header__description { max-width: 46rem; margin: 1.75rem 0 0; color: var(--color-muted); font-size: clamp(1.18rem, 2.6vw, 1.55rem); line-height: 1.5; }
  .article-header__episode { margin: .6rem 0 0; color: var(--color-accent); font-weight: 750; }
  .article-header__dates { display: flex; flex-wrap: wrap; gap: .55rem 1.5rem; margin-top: 2rem; color: var(--color-muted); font: .76rem var(--font-mono); }
  .article-hero { margin-bottom: clamp(2.5rem, 7vw, 5rem); }
  .article-hero img { width: 100%; max-height: 42rem; object-fit: cover; border: 1px solid var(--color-border); }
  .article-body { padding-bottom: clamp(5rem, 10vw, 8rem); }
  .article-next { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
  .article-next p { margin: 0 0 .45rem; }
  .article-next a { font-size: 1.2rem; font-weight: 750; }
</style>
