---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getSubmission } from '../../../../lib/submissions/repository.ts';
import { submissionStatuses } from '../../../../lib/submissions/types.ts';

const { reference } = Astro.params;
if (!reference) return Astro.redirect('/admin/submissions/');

const submission = await getSubmission(env.SUBMISSIONS_DB, reference);
if (!submission) return new Response('Not found', { status: 404 });

const escapeHtml = (value: string) =>
  value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] ?? char);

const payloadEntries = Object.entries(submission.payload).filter(([key]) => key !== 'kind' && key !== 'subtype');
---

<AdminLayout title={submission.publicReference}>
  <p><a href="/admin/submissions/">&larr; Back to submissions</a></p>
  <h1>{submission.publicReference}</h1>
  <p class="admin-meta">{submission.kind}{submission.subtype ? ` / ${submission.subtype}` : ''} &middot; received {submission.createdAt} &middot; status <strong>{submission.status}</strong>{submission.statusUpdatedBy ? ` (by ${submission.statusUpdatedBy})` : ''}</p>

  <section class="admin-permissions">
    <h2>Permissions</h2>
    <dl>
      {'contactPermission' in submission.payload && (
        <div><dt>Contact permission</dt><dd>{submission.payload.contactPermission ? 'Yes' : 'No'}</dd></div>
      )}
      {'publicationPermission' in submission.payload && (
        <div><dt>Publication permission</dt><dd>{String(submission.payload.publicationPermission)}</dd></div>
      )}
      {'recordingPermission' in submission.payload && (
        <div><dt>Recording acknowledged</dt><dd>{submission.payload.recordingPermission ? 'Yes' : 'No'}</dd></div>
      )}
    </dl>
  </section>

  <section class="admin-fields">
    <h2>Submitted content</h2>
    <dl>
      {payloadEntries.map(([key, value]) => (
        <div>
          <dt>{key}</dt>
          <dd set:html={escapeHtml(String(value ?? '')).replace(/\n/g, '<br />')} />
        </div>
      ))}
    </dl>
  </section>

  <section class="admin-actions">
    <h2>Update status</h2>
    <form method="post" action={`/admin/submissions/${submission.publicReference}/status/`}>
      <select name="status">
        {submissionStatuses.map((value) => (
          <option value={value} selected={value === submission.status}>{value}</option>
        ))}
      </select>
      <button type="submit">Update status</button>
    </form>

    <h2>Delete</h2>
    <p>Deleting a submission is permanent and cannot be undone.</p>
    <form method="post" action={`/admin/submissions/${submission.publicReference}/delete/`} onsubmit="return confirm('Permanently delete this submission? This cannot be undone.');">
      <input type="hidden" name="confirm" value="yes" />
      <button type="submit" class="admin-delete">Permanently delete</button>
    </form>
  </section>
</AdminLayout>

<style>
  .admin-meta {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .admin-permissions dl,
  .admin-fields dl {
    display: grid;
    gap: 0.5rem;
    margin: 0.75rem 0 1.5rem;
  }

  .admin-permissions dt,
  .admin-fields dt {
    font-size: 0.75rem;
    font-weight: 750;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .admin-permissions dd,
  .admin-fields dd {
    margin: 0.15rem 0 0;
  }

  .admin-actions form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.75rem 0 1.5rem;
  }

  .admin-delete {
    background: var(--color-accent);
    color: var(--color-bg);
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-weight: 750;
  }
</style>
