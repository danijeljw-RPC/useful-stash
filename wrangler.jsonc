{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "useful-stash",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "usefulstash.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
